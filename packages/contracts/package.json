{
  "name": "@pingus/contracts",
  "version": "0.2.0",
  "private": true,
  "type": "commonjs",
  "description": "PINGUS² ERC-721 — no owner mint, immutable thresholds, immutable breeding windows, zero breed fee.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "hardhat compile && node scripts/extract-abi.js",
    "test": "hardhat test",
    "typecheck": "hardhat compile --quiet && tsc --noEmit",
    "clean": "rm -rf artifacts cache typechain-types .turbo",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network mainnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^3.0.0",
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@openzeppelin/contracts": "^5.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "chai": "^4.5.0",
    "ethers": "^6.13.4",
    "hardhat": "^3.21.2",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.14",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.7.2"
  }
}
